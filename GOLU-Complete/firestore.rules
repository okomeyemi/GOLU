rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function owner(uid){return signedIn() && request.auth.uid == uid;}
  match /users/{uid} { allow read,write: if owner(uid); }
  match /projects/{projectId} {
   allow read: if signedIn() && resource.data.uid == request.auth.uid;
   allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
   allow update,delete: if signedIn() && resource.data.uid == request.auth.uid;
   match /messages/{messageId} { allow read,write: if signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.uid == request.auth.uid; }
  }
  match /usage/{usageId} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
 }
}
